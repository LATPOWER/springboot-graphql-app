{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "1.0.0-001",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "comment": "Create the books collection with JSON Schema validator",
        "changes": [
          {
            "createCollection": {
              "collectionName": "books",
              "options": "{ validator: { $jsonSchema: { bsonType: 'object', required: ['title', 'authorId'], properties: { title: { bsonType: 'string', description: 'Book title' }, authorId: { bsonType: 'string', description: 'Reference to authors collection' }, isbn: { bsonType: 'string', description: 'ISBN-13' }, pages: { bsonType: 'int', description: 'Page count' } } } }, validationLevel: 'moderate' }"
            }
          }
        ],
        "rollback": [
          {
            "dropCollection": {
              "collectionName": "books"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "1.0.0-002",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "comment": "Create the authors collection",
        "changes": [
          {
            "createCollection": {
              "collectionName": "authors",
              "options": "{ validator: { $jsonSchema: { bsonType: 'object', required: ['name'], properties: { name: { bsonType: 'string', description: 'Author full name' }, email: { bsonType: 'string', description: 'Contact email' } } } } }"
            }
          }
        ],
        "rollback": [
          {
            "dropCollection": {
              "collectionName": "authors"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "1.0.0-003",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "comment": "Add unique index on books.isbn for fast lookups",
        "changes": [
          {
            "createIndex": {
              "collectionName": "books",
              "keys": "{ isbn: 1 }",
              "options": "{ unique: true, name: 'idx_books_isbn' }"
            }
          }
        ],
        "rollback": [
          {
            "dropIndex": {
              "collectionName": "books",
              "keys": "{ isbn: 1 }"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "1.0.0-004",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "comment": "Add index on books.authorId for join queries",
        "changes": [
          {
            "createIndex": {
              "collectionName": "books",
              "keys": "{ authorId: 1 }",
              "options": "{ name: 'idx_books_authorId' }"
            }
          }
        ],
        "rollback": [
          {
            "dropIndex": {
              "collectionName": "books",
              "keys": "{ authorId: 1 }"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "1.0.0-005",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "comment": "Seed initial authors",
        "changes": [
          {
            "insertMany": {
              "collectionName": "authors",
              "documents": "[ { _id: 'author-001', name: 'Joshua Bloch', email: 'jbloch@example.com' }, { _id: 'author-002', name: 'Robert C. Martin', email: 'unclebob@example.com' }, { _id: 'author-003', name: 'Martin Kleppmann', email: 'kleppmann@example.com' } ]"
            }
          }
        ],
        "rollback": [
          {
            "runCommand": {
              "command": "{ delete: 'authors', deletes: [ { q: { _id: { $in: ['author-001', 'author-002', 'author-003'] } }, limit: 0 } ] }"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "1.0.0-006",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "comment": "Seed initial books",
        "changes": [
          {
            "insertMany": {
              "collectionName": "books",
              "documents": "[ { _id: 'book-001', title: 'Effective Java', authorId: 'author-001', isbn: '978-0134685991', pages: 416 }, { _id: 'book-002', title: 'Clean Code', authorId: 'author-002', isbn: '978-0132350884', pages: 464 }, { _id: 'book-003', title: 'Designing Data-Intensive Apps', authorId: 'author-003', isbn: '978-1449373320', pages: 616 } ]"
            }
          }
        ],
        "rollback": [
          {
            "runCommand": {
              "command": "{ delete: 'books', deletes: [ { q: { _id: { $in: ['book-001', 'book-002', 'book-003'] } }, limit: 0 } ] }"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "1.0.0-tag",
        "author": "admin",
        "labels": "release-1.0.0",
        "context": "all",
        "changes": [
          {
            "tagDatabase": {
              "tag": "release-1.0.0"
            }
          }
        ]
      }
    }
  ]
}
